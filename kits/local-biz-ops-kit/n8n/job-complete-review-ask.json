{
  "name": "Local Biz \u2014 Job Complete \u2192 Review Ask",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-b",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        280
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
